CONFIG_DRIVER_HOSTAP=n
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=openssl
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_IEEE80211W=y
CONFIG_SAE=y
CONFIG_WPS=n
CONFIG_EAP=n
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_CTRL_IFACE=y
CONFIG_IPV6=y
CONFIG_ACS=y
CONFIG_NO_VLAN=y
CONFIG_ELOOP_EPOLL=y
